# Copy to .env and fill in what you use. Use READ-ONLY API keys (no trading, no withdrawals)
# and restrict them to your IP address if the exchange lets you.

# Bybit (USDT perpetuals, unified account)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_BASE=https://api.bybit.com        # use https://api.bytick.com if api.bybit.com is blocked for you

# Binance USDT-M futures
BINANCE_API_KEY=
BINANCE_API_SECRET=
# SYMBOLS=BTCUSDT,ETHUSDT                 # Binance only: always sync these even if income history misses them

# How far back the first sync goes (days). Bybit keeps 2 years of executions, Binance ~6 months.
# SYNC_DAYS=90

# Where public candles come from for the running P&L (bybit or binance). No key needed.
# PRICE_SOURCE=bybit
